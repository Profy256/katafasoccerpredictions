# Admin panel configuration.
#
# Copy to .env.local and adjust. .env.local is gitignored; this file is not,
# so it is the only record of which variables exist.

# Where the Go API lives. Required, no default. Same backend the public
# frontend talks to — this app is a second, admin-only client of it.
#
# Not NEXT_PUBLIC_: every call is server-side, so this can point at an
# internal address the browser never resolves.
KATAFA_API_URL=http://localhost:8080

# Frontend configuration.
#
# Copy to .env.local and adjust. .env.local is gitignored; this file is not,
# so it is the only record of which variables exist — keep it in step with the
# code.

# Where the Go API lives. Required, with no default: a silent fallback to
# localhost in production produces a site that renders empty rather than one
# that fails loudly.
#
# Deliberately not NEXT_PUBLIC_. Every call is made server-side, so the API can
# live on an internal address the browser never resolves — and prefixing it
# would ship the URL to the browser for no reason.
KATAFA_API_URL=http://localhost:8080

# Absolute origin of this site, used to resolve Open Graph and Twitter image
# URLs. Crawlers reject relative ones, so this must be the real public origin
# in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact address for the /about page — corrections, data disputes and
# press. Optional: when unset the page points readers at the FAQ instead,
# because a published address that bounces is worse than no address at all.
NEXT_PUBLIC_CONTACT_EMAIL=

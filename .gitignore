# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Patterns are deliberately unanchored so they match inside frontend/ and
# backend/ as well as at the root. The previous root-anchored forms (/node_modules,
# /.next/) stopped matching the moment the frontend moved into its own folder.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
#
# Real secrets never get committed, but the *examples* must be, or nobody
# knows which variables exist. The negations below are what make that work —
# without them `.env*` swallows the templates too.
.env
.env.*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Go
backend/bin/
*.exe

# transient staging dir used by backend/tools/parity/generate.sh
.parity-stage.*

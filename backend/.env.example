# Backend configuration.
#
# Copy to .env and adjust. .env is gitignored; this file is not, so it is the
# only record of which variables exist — keep it in step with internal/config.
#
# Nothing here loads a .env automatically: `config.Load` reads the process
# environment and validates it at boot, collecting every problem before it
# returns so a misconfigured deploy reports all its faults in one pass. Source
# this file, or let your process manager inject it:
#
#   set -a && . ./.env && set +a

# ---------------------------------------------------------------------------
# Always required
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://katafa:katafa@localhost:5433/katafa?sslmode=disable

# development | staging | production. Production additionally requires every
# secret in the last section.
ENV=development

PORT=8080
LOG_LEVEL=info

# Stamped onto every prediction, and the accuracy dashboard reports per
# version. An unstamped prediction cannot be attributed to the model that made
# it, so this has no default.
MODEL_VERSION=poisson-1.2.0

# Absolute, no trailing slash. Used to build the MarzPay callback_url, so it
# must be an origin MarzPay can actually reach — not localhost in production.
PUBLIC_BASE_URL=http://localhost:8080

# Comma-separated Next.js origins. There is no wildcard fallback: defaulting to
# "*" on a missing value is how a permissive CORS policy reaches production
# unnoticed.
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# A Postgres server the suite may CREATE DATABASE on — each test gets its own,
# dropped afterwards. When unset the database tests SKIP rather than fail, so
# `go test ./...` still runs everywhere. CI must set it, and asserts the suite
# did not skip.
TEST_DATABASE_URL=postgres://katafa:katafa@localhost:5433/katafa?sslmode=disable

# ---------------------------------------------------------------------------
# Required in production only
#
# Development runs against a fake payment provider and recorded ingestion
# fixtures. Demanding live credentials to boot locally is what pushes people to
# paste real ones into a .env they then commit — so leave these empty here.
# ---------------------------------------------------------------------------

FOOTBALL_DATA_TOKEN=
APIFOOTBALL_KEY=

MARZPAY_API_USER=
MARZPAY_API_KEY=

# HMAC secret for verifying callback signatures.
#
# WARNING: the signature scheme is currently an assumption — HMAC-SHA256 over
# the raw body, read from X-Marzpay-Signature. Verify it against the live
# MarzPay dashboard before going near real money. If it is wrong, every
# callback fails verification, is recorded with signature_valid = false, and is
# never acted on; purchases would then complete only via reconcile_payments,
# silently and slowly.
MARZPAY_WEBHOOK_SECRET=

MARZPAY_BASE_URL=https://wallet.wearemarz.com/api/v1

# Cookie domain for sessions, e.g. .katafa.app
SESSION_COOKIE_DOMAIN=
